# Copy to .env.local for local dev. Real values go in Vercel env vars. Never commit .env files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Phase 6). Mode: unconfigured | sandbox | live
FIB_MODE=unconfigured
FIB_BASE_URL=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=

QI_MODE=unconfigured
QI_BASE_URL=
QI_TERMINAL_ID=
QI_USERNAME=
QI_PASSWORD=
QI_WEBHOOK_SECRET=

PUBLIC_API_BASE_URL=

# Local dev only: allow the Flutter web build to call this API (never set in production)
ALLOW_DEV_CORS=
